digraph LittleLemon {
  graph [rankdir=LR, bgcolor="white", pad="0.28", nodesep="0.55", ranksep="1.0", splines=polyline, fontname="Helvetica", fontsize=19, labelloc=t, label="Little Lemon Database\nDeployed MySQL schema", dpi=160];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [color="#587267", penwidth=1.3, fontname="Helvetica", fontsize=10, arrowsize=0.85, labeldistance=1.8];
  "Bookings" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#cad8ce"><TR><TD COLSPAN="4" BGCOLOR="#24483e" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="14"><B>Bookings</B></FONT></TD></TR><TR><TD BGCOLOR="#edf3ee"><B>Key</B></TD><TD BGCOLOR="#edf3ee"><B>Column</B></TD><TD BGCOLOR="#edf3ee"><B>Type</B></TD><TD BGCOLOR="#edf3ee"><B>Null</B></TD></TR><TR><TD PORT="left_column_0" BGCOLOR="white" ALIGN="LEFT">PK</TD><TD BGCOLOR="white" ALIGN="LEFT">BookingID</TD><TD BGCOLOR="white" ALIGN="LEFT">int unsigned</TD><TD PORT="right_column_0" BGCOLOR="white">NO</TD></TR><TR><TD PORT="left_column_1" BGCOLOR="#f8faf8" ALIGN="LEFT">FK</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">CustomerID</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">varchar(32)</TD><TD PORT="right_column_1" BGCOLOR="#f8faf8">NO</TD></TR><TR><TD PORT="left_column_2" BGCOLOR="white" ALIGN="LEFT"></TD><TD BGCOLOR="white" ALIGN="LEFT">BookingDate</TD><TD BGCOLOR="white" ALIGN="LEFT">date</TD><TD PORT="right_column_2" BGCOLOR="white">NO</TD></TR><TR><TD PORT="left_column_3" BGCOLOR="#f8faf8" ALIGN="LEFT"></TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">TableNo</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">tinyint unsigned</TD><TD PORT="right_column_3" BGCOLOR="#f8faf8">NO</TD></TR></TABLE>>];
  "Customers" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#cad8ce"><TR><TD COLSPAN="4" BGCOLOR="#24483e" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="14"><B>Customers</B></FONT></TD></TR><TR><TD BGCOLOR="#edf3ee"><B>Key</B></TD><TD BGCOLOR="#edf3ee"><B>Column</B></TD><TD BGCOLOR="#edf3ee"><B>Type</B></TD><TD BGCOLOR="#edf3ee"><B>Null</B></TD></TR><TR><TD PORT="left_column_0" BGCOLOR="white" ALIGN="LEFT">PK</TD><TD BGCOLOR="white" ALIGN="LEFT">CustomerID</TD><TD BGCOLOR="white" ALIGN="LEFT">varchar(32)</TD><TD PORT="right_column_0" BGCOLOR="white">NO</TD></TR><TR><TD PORT="left_column_1" BGCOLOR="#f8faf8" ALIGN="LEFT"></TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">CustomerName</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">varchar(150)</TD><TD PORT="right_column_1" BGCOLOR="#f8faf8">NO</TD></TR><TR><TD PORT="left_column_2" BGCOLOR="white" ALIGN="LEFT"></TD><TD BGCOLOR="white" ALIGN="LEFT">City</TD><TD BGCOLOR="white" ALIGN="LEFT">varchar(150)</TD><TD PORT="right_column_2" BGCOLOR="white">NO</TD></TR><TR><TD PORT="left_column_3" BGCOLOR="#f8faf8" ALIGN="LEFT"></TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">Country</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">varchar(150)</TD><TD PORT="right_column_3" BGCOLOR="#f8faf8">NO</TD></TR><TR><TD PORT="left_column_4" BGCOLOR="white" ALIGN="LEFT"></TD><TD BGCOLOR="white" ALIGN="LEFT">CountryCode</TD><TD BGCOLOR="white" ALIGN="LEFT">varchar(8)</TD><TD PORT="right_column_4" BGCOLOR="white">NO</TD></TR></TABLE>>];
  "MenuComponents" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#cad8ce"><TR><TD COLSPAN="4" BGCOLOR="#24483e" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="14"><B>MenuComponents</B></FONT></TD></TR><TR><TD BGCOLOR="#edf3ee"><B>Key</B></TD><TD BGCOLOR="#edf3ee"><B>Column</B></TD><TD BGCOLOR="#edf3ee"><B>Type</B></TD><TD BGCOLOR="#edf3ee"><B>Null</B></TD></TR><TR><TD PORT="left_column_0" BGCOLOR="white" ALIGN="LEFT">PK, FK</TD><TD BGCOLOR="white" ALIGN="LEFT">MenuID</TD><TD BGCOLOR="white" ALIGN="LEFT">int unsigned</TD><TD PORT="right_column_0" BGCOLOR="white">NO</TD></TR><TR><TD PORT="left_column_1" BGCOLOR="#f8faf8" ALIGN="LEFT">PK, FK</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">ComponentRole</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">varchar(20)</TD><TD PORT="right_column_1" BGCOLOR="#f8faf8">NO</TD></TR><TR><TD PORT="left_column_2" BGCOLOR="white" ALIGN="LEFT">FK</TD><TD BGCOLOR="white" ALIGN="LEFT">ItemID</TD><TD BGCOLOR="white" ALIGN="LEFT">int unsigned</TD><TD PORT="right_column_2" BGCOLOR="white">NO</TD></TR></TABLE>>];
  "MenuItems" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#cad8ce"><TR><TD COLSPAN="4" BGCOLOR="#24483e" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="14"><B>MenuItems</B></FONT></TD></TR><TR><TD BGCOLOR="#edf3ee"><B>Key</B></TD><TD BGCOLOR="#edf3ee"><B>Column</B></TD><TD BGCOLOR="#edf3ee"><B>Type</B></TD><TD BGCOLOR="#edf3ee"><B>Null</B></TD></TR><TR><TD PORT="left_column_0" BGCOLOR="white" ALIGN="LEFT">PK</TD><TD BGCOLOR="white" ALIGN="LEFT">ItemID</TD><TD BGCOLOR="white" ALIGN="LEFT">int unsigned</TD><TD PORT="right_column_0" BGCOLOR="white">NO</TD></TR><TR><TD PORT="left_column_1" BGCOLOR="#f8faf8" ALIGN="LEFT"></TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">ItemName</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">varchar(150)</TD><TD PORT="right_column_1" BGCOLOR="#f8faf8">NO</TD></TR><TR><TD PORT="left_column_2" BGCOLOR="white" ALIGN="LEFT"></TD><TD BGCOLOR="white" ALIGN="LEFT">ItemType</TD><TD BGCOLOR="white" ALIGN="LEFT">varchar(20)</TD><TD PORT="right_column_2" BGCOLOR="white">NO</TD></TR></TABLE>>];
  "Menus" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#cad8ce"><TR><TD COLSPAN="4" BGCOLOR="#24483e" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="14"><B>Menus</B></FONT></TD></TR><TR><TD BGCOLOR="#edf3ee"><B>Key</B></TD><TD BGCOLOR="#edf3ee"><B>Column</B></TD><TD BGCOLOR="#edf3ee"><B>Type</B></TD><TD BGCOLOR="#edf3ee"><B>Null</B></TD></TR><TR><TD PORT="left_column_0" BGCOLOR="white" ALIGN="LEFT">PK</TD><TD BGCOLOR="white" ALIGN="LEFT">MenuID</TD><TD BGCOLOR="white" ALIGN="LEFT">int unsigned</TD><TD PORT="right_column_0" BGCOLOR="white">NO</TD></TR><TR><TD PORT="left_column_1" BGCOLOR="#f8faf8" ALIGN="LEFT"></TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">CuisineName</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">varchar(100)</TD><TD PORT="right_column_1" BGCOLOR="#f8faf8">NO</TD></TR><TR><TD PORT="left_column_2" BGCOLOR="white" ALIGN="LEFT">UK</TD><TD BGCOLOR="white" ALIGN="LEFT">BundleKey</TD><TD BGCOLOR="white" ALIGN="LEFT">char(64)</TD><TD PORT="right_column_2" BGCOLOR="white">NO</TD></TR></TABLE>>];
  "OrderDeliveryStatus" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#cad8ce"><TR><TD COLSPAN="4" BGCOLOR="#24483e" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="14"><B>OrderDeliveryStatus</B></FONT></TD></TR><TR><TD BGCOLOR="#edf3ee"><B>Key</B></TD><TD BGCOLOR="#edf3ee"><B>Column</B></TD><TD BGCOLOR="#edf3ee"><B>Type</B></TD><TD BGCOLOR="#edf3ee"><B>Null</B></TD></TR><TR><TD PORT="left_column_0" BGCOLOR="white" ALIGN="LEFT">PK, FK</TD><TD BGCOLOR="white" ALIGN="LEFT">OrderID</TD><TD BGCOLOR="white" ALIGN="LEFT">int unsigned</TD><TD PORT="right_column_0" BGCOLOR="white">NO</TD></TR><TR><TD PORT="left_column_1" BGCOLOR="#f8faf8" ALIGN="LEFT"></TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">DeliveryDate</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">date</TD><TD PORT="right_column_1" BGCOLOR="#f8faf8">NO</TD></TR></TABLE>>];
  "Orders" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#cad8ce"><TR><TD COLSPAN="4" BGCOLOR="#24483e" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="14"><B>Orders</B></FONT></TD></TR><TR><TD BGCOLOR="#edf3ee"><B>Key</B></TD><TD BGCOLOR="#edf3ee"><B>Column</B></TD><TD BGCOLOR="#edf3ee"><B>Type</B></TD><TD BGCOLOR="#edf3ee"><B>Null</B></TD></TR><TR><TD PORT="left_column_0" BGCOLOR="white" ALIGN="LEFT">PK</TD><TD BGCOLOR="white" ALIGN="LEFT">OrderID</TD><TD BGCOLOR="white" ALIGN="LEFT">int unsigned</TD><TD PORT="right_column_0" BGCOLOR="white">NO</TD></TR><TR><TD PORT="left_column_1" BGCOLOR="#f8faf8" ALIGN="LEFT"></TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">SourceOrderID</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">varchar(32)</TD><TD PORT="right_column_1" BGCOLOR="#f8faf8">NO</TD></TR><TR><TD PORT="left_column_2" BGCOLOR="white" ALIGN="LEFT">FK</TD><TD BGCOLOR="white" ALIGN="LEFT">CustomerID</TD><TD BGCOLOR="white" ALIGN="LEFT">varchar(32)</TD><TD PORT="right_column_2" BGCOLOR="white">NO</TD></TR><TR><TD PORT="left_column_3" BGCOLOR="#f8faf8" ALIGN="LEFT">FK</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">MenuID</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">int unsigned</TD><TD PORT="right_column_3" BGCOLOR="#f8faf8">NO</TD></TR><TR><TD PORT="left_column_4" BGCOLOR="white" ALIGN="LEFT"></TD><TD BGCOLOR="white" ALIGN="LEFT">OrderDate</TD><TD BGCOLOR="white" ALIGN="LEFT">date</TD><TD PORT="right_column_4" BGCOLOR="white">NO</TD></TR><TR><TD PORT="left_column_5" BGCOLOR="#f8faf8" ALIGN="LEFT"></TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">PostalCodeRaw</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">varchar(64)</TD><TD PORT="right_column_5" BGCOLOR="#f8faf8">NO</TD></TR><TR><TD PORT="left_column_6" BGCOLOR="white" ALIGN="LEFT"></TD><TD BGCOLOR="white" ALIGN="LEFT">Cost</TD><TD BGCOLOR="white" ALIGN="LEFT">decimal(18,4)</TD><TD PORT="right_column_6" BGCOLOR="white">NO</TD></TR><TR><TD PORT="left_column_7" BGCOLOR="#f8faf8" ALIGN="LEFT"></TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">Sales</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">decimal(18,4)</TD><TD PORT="right_column_7" BGCOLOR="#f8faf8">NO</TD></TR><TR><TD PORT="left_column_8" BGCOLOR="white" ALIGN="LEFT"></TD><TD BGCOLOR="white" ALIGN="LEFT">Quantity</TD><TD BGCOLOR="white" ALIGN="LEFT">smallint unsigned</TD><TD PORT="right_column_8" BGCOLOR="white">NO</TD></TR><TR><TD PORT="left_column_9" BGCOLOR="#f8faf8" ALIGN="LEFT"></TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">Discount</TD><TD BGCOLOR="#f8faf8" ALIGN="LEFT">decimal(18,4)</TD><TD PORT="right_column_9" BGCOLOR="#f8faf8">NO</TD></TR><TR><TD PORT="left_column_10" BGCOLOR="white" ALIGN="LEFT"></TD><TD BGCOLOR="white" ALIGN="LEFT">DeliveryCost</TD><TD BGCOLOR="white" ALIGN="LEFT">decimal(18,4)</TD><TD PORT="right_column_10" BGCOLOR="white">NO</TD></TR></TABLE>>];
  "Customers":right_column_0:e -> "Bookings":left_column_1:w [dir=both, arrowtail=tee, arrowhead=odotcrow, taillabel="1", headlabel="0..N"];
  "MenuItems":right_column_0:e -> "MenuComponents":left_column_2:w [dir=both, arrowtail=tee, arrowhead=odotcrow, taillabel="1", headlabel="0..N"];
  "Menus":right_column_0:e -> "MenuComponents":left_column_0:w [dir=both, arrowtail=tee, arrowhead=odotcrow, taillabel="1", headlabel="0..N"];
  "Orders":right_column_0:e -> "OrderDeliveryStatus":left_column_0:w [dir=both, arrowtail=tee, arrowhead=odottee, taillabel="1", headlabel="0..1"];
  "Customers":right_column_0:e -> "Orders":left_column_2:w [dir=both, arrowtail=tee, arrowhead=odotcrow, taillabel="1", headlabel="0..N"];
  "Menus":right_column_0:e -> "Orders":left_column_3:w [dir=both, arrowtail=tee, arrowhead=odotcrow, taillabel="1", headlabel="0..N"];
  note [shape=box, style="rounded,filled", fillcolor="#f5f8f5", color="#cad8ce", fontcolor="#24483e", fontsize=11, margin="0.18,0.12", label="PK: primary key   FK: foreign key   UK: single-column unique key\lNull: whether a column permits SQL NULL\l\lOrders.OrderID = workbook Row Number. SourceOrderID is retained and is not unique.\lMenuComponents describes bundle membership, not item-level order quantities.\lBookings are separately labeled fixtures; no workbook booking association is invented.\lCardinalities describe constraints, not observed row counts.\l"];
}
